# ── Application ─────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200   # comma-separated; empty = no cross-origin access
BODY_LIMIT=1mb
SWAGGER_ENABLED=true            # set false in production

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_portal?schema=public"
DB_TX_TIMEOUT_MS=10000          # max duration of one transaction
DB_TX_MAX_WAIT_MS=5000          # max wait to obtain a connection

# ── Rate limiting (per client IP) ───────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
STRICT_THROTTLE_TTL_MS=60000    # login, refresh, change-password
STRICT_THROTTLE_LIMIT=10

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -base64 48   (minimum 32 characters; NEVER reuse across environments)
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900      # 15 minutes
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=university-portal
JWT_AUDIENCE=university-portal-clients

# ── Password hashing (argon2id) and policy ──────────────────
ARGON2_MEMORY_COST_KIB=19456    # 19 MiB (OWASP minimum with time cost 2). Raise as hardware allows.
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5            # failed sign-ins before the account is locked
LOGIN_LOCK_MINUTES=15

# ── Pagination ──────────────────────────────────────────────
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ── Idempotency (Idempotency-Key header) ────────────────────
IDEMPOTENCY_TTL_HOURS=24                 # how long a completed response can be replayed
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60      # how long an in-flight key blocks duplicates
IDEMPOTENCY_KEY_MAX_LENGTH=128

# ── Transactional outbox ────────────────────────────────────
OUTBOX_ENABLED=true             # false on instances that must not dispatch events
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_MS=30000
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent
LOG_PRETTY=true                 # human-readable logs; keep false in production

# ── First-run seeding (only read by `npm run seed`; remove afterwards) ──
SEED_ADMIN_EMAIL=admin@your-university.ac.ke
SEED_ADMIN_PASSWORD=
# true = add missing preset permissions to roles that already exist (additive only; never removes).
SEED_REAPPLY_PRESETS=false
